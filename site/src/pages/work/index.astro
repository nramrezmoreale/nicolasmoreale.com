---
import Base from '../../layouts/Base.astro';
import WorkList from '../../components/WorkList.astro';
import CallToAction from '../../components/CallToAction.astro';
---

<Base
  title="Work"
  description="Case studies from AWS projects: Amazon Connect contact centers, data engineering and cloud infrastructure."
>
  <header class="wrap page-head">
    <h1>Work</h1>
    <p>
      Problems I've solved on AWS, in contact centers, data and cloud infrastructure. Client names and
      identifying details are left out; the technical substance is not.
    </p>
  </header>
  <div class="wrap">
    <WorkList />
  </div>
  <CallToAction />
</Base>

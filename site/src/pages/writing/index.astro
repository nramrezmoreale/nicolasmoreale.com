---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site } from '../../site.config';

const articles = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const fmt = new Intl.DateTimeFormat('en-US', { dateStyle: 'long', timeZone: 'UTC' });
---

<Base
  title="Writing"
  description="Notes on AWS: data engineering, Amazon Connect, cloud infrastructure and generative AI."
>
  <header class="wrap page-head">
    <h1>Writing</h1>
    <p>
      Notes on AWS: data engineering, Amazon Connect, cloud infrastructure and generative AI. Some
      are published on AWS Builder Center, and open there.
    </p>
  </header>

  <div class="wrap">
    <ul class="articles">
      {
        articles.map((a) => (
          <li>
            <h2>
              <a href={a.data.url ?? `/writing/${a.id}/`}>{a.data.title}</a>
            </h2>
            <p>{a.data.description}</p>
            <p class="date ui">
              <time datetime={a.data.pubDate.toISOString()}>{fmt.format(a.data.pubDate)}</time>
              {a.data.source && (
                <>
                  <span aria-hidden="true"> · </span>
                  <span class="source">
                    On {a.data.source}
                    <span aria-hidden="true"> ↗</span>
                  </span>
                </>
              )}
            </p>
          </li>
        ))
      }
    </ul>
    {
      site.builderCenter && (
        <p class="more ui">
          <a href={site.builderCenter}>All my posts on AWS Builder Center</a>
        </p>
      )
    }
  </div>
</Base>

<style>
  .articles {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  li {
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--rule);
    max-width: 46rem;
  }

  h2 {
    font-size: var(--step-2);
  }

  h2 a {
    color: var(--ink);
    text-decoration-color: var(--rule);
  }

  h2 a:hover {
    text-decoration-color: var(--accent);
  }

  li p {
    margin-top: 0.6rem;
  }

  .date {
    color: var(--muted);
    font-size: 0.95rem;
  }

  .more {
    margin-top: 1.75rem;
  }
</style>

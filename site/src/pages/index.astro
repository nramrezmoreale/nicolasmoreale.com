---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import portrait from '../assets/nicolas-moreale.jpg';
import Base from '../layouts/Base.astro';
import StackDiagram from '../components/StackDiagram.astro';
import WorkList from '../components/WorkList.astro';
import CallToAction from '../components/CallToAction.astro';
import { practices, site, support } from '../site.config';

// The two newest articles not marked featured: false.
const latest = (await getCollection('writing', ({ data }) => !data.draft && data.featured))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);
---

<Base>
  <section class="hero wrap" aria-labelledby="hero-heading">
    <div class="hero-text">
      <h1 id="hero-heading">I build data pipelines, contact centers and cloud infrastructure on AWS.</h1>
      <p class="lede">
        Independent AWS engineer in {site.location.split(',')[0]}, working with teams in the US and
        Europe. My focus is data engineering: pipelines and data lakes that turn scattered sources into
        reporting people trust. I also build Amazon Connect contact centers, and the AWS infrastructure
        under both.
      </p>
      <div class="actions">
        <a class="button" href={site.bookingUrl}>Book a 30-minute call</a>
        <a class="button button--quiet" href="/work/">Read the case studies</a>
      </div>
      <p class="note ui">Available during US business hours. I work in English and Spanish.</p>
    </div>
    <div class="hero-figure">
      <StackDiagram />
    </div>
  </section>

  <section class="wrap block" aria-labelledby="services-heading">
    <div class="block-head">
      <h2 id="services-heading">What I work on</h2>
      <a class="ui" href="/services/">What each service includes</a>
    </div>
    <ul class="practices">
      {
        practices.map((p) => (
          <li>
            <h3>
              <a href={`/services/#${p.slug}`}>{p.name}</a>
            </h3>
            <p class="tools ui">{p.tools}</p>
            <p>{p.summary}</p>
            <ul class="offers ui">
              {p.services.map((s) => (
                <li>
                  <a href={`/services/#${s.slug}`}>{s.name}</a>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
    <p class="engage">
      Work comes as a fixed-price review, a scoped project or a monthly{' '}
      <a href={`/services/#${support.slug}`}>support retainer</a>, and every engagement starts with a
      30-minute call and a written scope.
    </p>
  </section>

  <section class="wrap block" aria-labelledby="work-heading">
    <div class="block-head">
      <h2 id="work-heading">Recent work</h2>
      <a class="ui" href="/work/">All case studies</a>
    </div>
    <WorkList onePerArea />
  </section>

  {
    latest.length > 0 && (
      <section class="wrap block" aria-labelledby="writing-heading">
        <div class="block-head">
          <h2 id="writing-heading">Latest writing</h2>
          <a class="ui" href="/writing/">All articles</a>
        </div>
        {latest.map((a) => (
          <article class="latest">
            <h3>
              <a href={a.data.url ?? `/writing/${a.id}/`}>{a.data.title}</a>
            </h3>
            <p>{a.data.description}</p>
            {a.data.source && (
              <p class="source ui">
                On {a.data.source}
                <span aria-hidden="true"> ↗</span>
              </p>
            )}
          </article>
        ))}
      </section>
    )
  }

  <section class="wrap block about" aria-labelledby="about-heading">
    <h2 id="about-heading">Why work with me</h2>
    <div class="about-grid">
      <Image
        class="portrait"
        src={portrait}
        alt="Nicolás Moreale"
        widths={[200, 400]}
        sizes="(min-width: 52rem) 11rem, 7rem"
      />
      <p>
        I'm a data engineer with a degree in data science. I build AWS data lakes and ETL pipelines that
        pull from databases, files and APIs, clean and validate the data in Glue, and give business teams
        reporting they can rely on instead of data prepared by hand.
      </p>
      <p>
        I also work inside Amazon Connect for regulated, pharmaceutical contact centers, where a wrong
        number on a report has consequences. That's taught me to care about the unglamorous parts:
        metric definitions, edge cases, and documentation someone can follow after I leave. Everything I
        build lives in your AWS account, as code, with access you control.
      </p>
      <p><a href="/about/">More about me</a></p>
    </div>
  </section>

  <CallToAction />
</Base>

<style>
  .hero {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    padding-block: clamp(3rem, 8vw, 6.5rem) clamp(2rem, 6vw, 4rem);
    align-items: center;
  }

  .lede {
    margin-top: 1.5rem;
    max-width: 34rem;
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .note {
    margin-top: 1.25rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .hero h1 {
    font-size: clamp(2.5rem, 1.5rem + 3vw, 3.75rem);
  }

  @media (min-width: 64rem) {
    .hero {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    }
  }

  .block {
    margin-top: clamp(3.5rem, 9vw, 6rem);
  }

  .block-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-bottom: 1.5rem;
  }

  .practices {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2rem 2.5rem;
  }

  .practices > li {
    border-top: 3px solid var(--ink);
    padding-top: 1.1rem;
    display: grid;
    gap: 0.6rem;
    align-content: start;
  }

  .practices h3 a {
    color: var(--ink);
    text-decoration: none;
  }

  .practices h3 a:hover {
    color: var(--accent);
  }

  .tools {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .offers {
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
    font-size: 0.98rem;
  }

  .offers a {
    text-decoration-color: var(--rule);
  }

  .offers a:hover {
    text-decoration-color: var(--accent);
  }

  .engage {
    margin-top: 2.25rem;
    max-width: 44rem;
    color: var(--muted);
  }

  @media (min-width: 60rem) {
    .practices {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .latest {
    border-top: 1px solid var(--rule);
    padding-top: 1.75rem;
    max-width: 46rem;
  }

  .latest h3 a {
    color: var(--ink);
    text-decoration-color: var(--rule);
  }

  .latest h3 a:hover {
    text-decoration-color: var(--accent);
  }

  .latest p {
    margin-top: 0.6rem;
  }

  .latest + .latest {
    margin-top: 1.75rem;
  }

  .latest .source {
    color: var(--muted);
    font-size: 0.95rem;
  }

  .about-grid {
    display: grid;
    gap: 1.25rem 3rem;
    margin-top: 1.5rem;
  }

  .about-grid p {
    max-width: 36rem;
  }

  .about-grid .portrait {
    width: 7rem;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--rule);
  }

  @media (min-width: 52rem) {
    .about-grid {
      grid-template-columns: 11rem 1fr 1fr;
    }
    .about-grid .portrait {
      width: 11rem;
      grid-row: span 2;
    }
  }
</style>

---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import StackDiagram from '../components/StackDiagram.astro';
import WorkList from '../components/WorkList.astro';
import CallToAction from '../components/CallToAction.astro';
import { practices, site, support } from '../site.config';

const articles = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latest = articles[0];
---

<Base>
  <section class="hero wrap" aria-labelledby="hero-heading">
    <div class="hero-text">
      <h1 id="hero-heading">I build contact centers, data pipelines and cloud infrastructure on AWS.</h1>
      <p class="lede">
        Independent AWS engineer in {site.location.split(',')[0]}, working with teams in the US and
        Europe. Amazon Connect is the biggest part of my work. I also build data pipelines and data
        lakes, and set up the AWS accounts, security and automation everything runs on.
      </p>
      <div class="actions">
        <a class="button" href={site.bookingUrl}>Book a 30-minute call</a>
        <a class="button button--quiet" href="/work/">Read the case studies</a>
      </div>
      <p class="note ui">Available during US business hours. I work in English and Spanish.</p>
    </div>
    <div class="hero-figure">
      <StackDiagram />
    </div>
  </section>

  <section class="wrap block" aria-labelledby="services-heading">
    <div class="block-head">
      <h2 id="services-heading">What I work on</h2>
      <a class="ui" href="/services/">What each service includes</a>
    </div>
    <ul class="practices">
      {
        practices.map((p) => (
          <li>
            <h3>
              <a href={`/services/#${p.slug}`}>{p.name}</a>
            </h3>
            <p class="tools ui">{p.tools}</p>
            <p>{p.summary}</p>
            <ul class="offers ui">
              {p.services.map((s) => (
                <li>
                  <a href={`/services/#${s.slug}`}>{s.name}</a>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
    <p class="engage">
      Work comes as a fixed-price review, a scoped project or a monthly{' '}
      <a href={`/services/#${support.slug}`}>support retainer</a>, and every engagement starts with a
      30-minute call and a written scope.
    </p>
  </section>

  <section class="wrap block" aria-labelledby="work-heading">
    <div class="block-head">
      <h2 id="work-heading">Recent work</h2>
      <a class="ui" href="/work/">All case studies</a>
    </div>
    <WorkList onePerArea />
  </section>

  {
    latest && (
      <section class="wrap block" aria-labelledby="writing-heading">
        <div class="block-head">
          <h2 id="writing-heading">Latest writing</h2>
          <a class="ui" href="/writing/">All articles</a>
        </div>
        <article class="latest">
          <h3>
            <a href={`/writing/${latest.id}/`}>{latest.data.title}</a>
          </h3>
          <p>{latest.data.description}</p>
        </article>
      </section>
    )
  }

  <section class="wrap block about" aria-labelledby="about-heading">
    <h2 id="about-heading">Why work with me</h2>
    <div class="about-grid">
      <p>
        I spend my days inside Amazon Connect for regulated, pharmaceutical contact centers, where a
        misrouted call or a wrong number on a report has consequences. I care about the unglamorous
        parts: holiday tables, voicemail delivery, metric definitions, and documentation someone can
        follow after I leave.
      </p>
      <p>
        Before that I was a data engineer, and I have a degree in data science. So I don't stop at the
        contact flow: I build the pipelines and reports behind it, and the AWS infrastructure under both,
        as code, in your account, with access you control.
      </p>
      <p><a href="/about/">More about me</a></p>
    </div>
  </section>

  <CallToAction />
</Base>

<style>
  .hero {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    padding-block: clamp(3rem, 8vw, 6.5rem) clamp(2rem, 6vw, 4rem);
    align-items: center;
  }

  .lede {
    margin-top: 1.5rem;
    max-width: 34rem;
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .note {
    margin-top: 1.25rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .hero h1 {
    font-size: clamp(2.5rem, 1.5rem + 3vw, 3.75rem);
  }

  @media (min-width: 64rem) {
    .hero {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    }
  }

  .block {
    margin-top: clamp(3.5rem, 9vw, 6rem);
  }

  .block-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-bottom: 1.5rem;
  }

  .practices {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2rem 2.5rem;
  }

  .practices > li {
    border-top: 3px solid var(--ink);
    padding-top: 1.1rem;
    display: grid;
    gap: 0.6rem;
    align-content: start;
  }

  .practices h3 a {
    color: var(--ink);
    text-decoration: none;
  }

  .practices h3 a:hover {
    color: var(--accent);
  }

  .tools {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .offers {
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
    font-size: 0.98rem;
  }

  .offers a {
    text-decoration-color: var(--rule);
  }

  .offers a:hover {
    text-decoration-color: var(--accent);
  }

  .engage {
    margin-top: 2.25rem;
    max-width: 44rem;
    color: var(--muted);
  }

  @media (min-width: 60rem) {
    .practices {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .latest {
    border-top: 1px solid var(--rule);
    padding-top: 1.75rem;
    max-width: 46rem;
  }

  .latest h3 a {
    color: var(--ink);
    text-decoration-color: var(--rule);
  }

  .latest h3 a:hover {
    text-decoration-color: var(--accent);
  }

  .latest p {
    margin-top: 0.6rem;
  }

  .about-grid {
    display: grid;
    gap: 1.25rem 3rem;
    margin-top: 1.5rem;
  }

  .about-grid p {
    max-width: 36rem;
  }

  @media (min-width: 52rem) {
    .about-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

---
// Architecture of the operational data lake case study. Static: same look as the
// homepage diagram, without the animation. Wide layout for desktop, tall for phones.
const label =
  'Architecture of the data lake, inside an AWS account. Sources (relational databases, REST APIs and CSV exports) are loaded by AWS Lambda functions run on EventBridge schedules into the raw zone of an S3 data lake. AWS Glue jobs in PySpark validate and deduplicate the data and write it to a curated zone in partitioned Parquet. The Glue Data Catalog holds the schemas, Amazon Athena queries the curated data with SQL, and Amazon QuickSight turns it into dashboards and reports. Amazon CloudWatch tracks job metrics, failed loads and alerts.';

// Box contents in pipeline order. The wide layout snakes: top row left to right,
// then the bottom row right to left. The tall layout is one column.
const steps = [
  { t: 'Sources', s: 'Databases, APIs, CSV' },
  { t: 'AWS Lambda', s: 'Run by EventBridge' },
  { t: 'S3 raw zone', s: 'Data as it arrived', lake: true },
  { t: 'Glue with PySpark', s: 'Validate, deduplicate' },
  { t: 'S3 curated zone', s: 'Parquet, partitioned', lake: true },
  { t: 'Glue Data Catalog', s: 'Schemas and tables' },
  { t: 'Amazon Athena', s: 'SQL on curated data' },
  { t: 'QuickSight', s: 'Dashboards, reports', end: true },
];

// Wide: four columns, two rows.
const W = { cols: [26, 220, 414, 608], w: 166, h: 64, rows: [52, 184] };
const wide = steps.map((step, i) => {
  const top = i < 4;
  const col = top ? i : 7 - i;
  return { ...step, x: W.cols[col], y: W.rows[top ? 0 : 1] };
});

// Tall: one column.
const T = { x: 20, w: 300, h: 48, y0: 44, step: 64 };
const tall = steps.map((step, i) => ({ ...step, x: T.x, y: T.y0 + i * T.step }));
const tallEnd = T.y0 + 7 * T.step + T.h;

const cls = (s: { lake?: boolean; end?: boolean }) => ['blk', s.lake && 'lake', s.end && 'end'].filter(Boolean).join(' ');
---

<figure class="diagram">
  <svg class="dl-svg dl-svg--wide" viewBox="0 0 800 360" role="img" aria-label={label}>
    <defs>
      <marker id="dl-arrow-w" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="8" markerHeight="8" orient="auto">
        <path d="M0 0 L8 4 L0 8 z" />
      </marker>
    </defs>

    <rect class="frame" x="6" y="6" width="788" height="346" rx="12" />
    <text class="frame-label" x="26" y="34">Your AWS account</text>

    <g class="wires">
      <line x1="193" y1="84" x2="219" y2="84" marker-end="url(#dl-arrow-w)" />
      <line x1="387" y1="84" x2="413" y2="84" marker-end="url(#dl-arrow-w)" />
      <line x1="581" y1="84" x2="607" y2="84" marker-end="url(#dl-arrow-w)" />
      <line x1="691" y1="117" x2="691" y2="183" marker-end="url(#dl-arrow-w)" />
      <line x1="607" y1="216" x2="581" y2="216" marker-end="url(#dl-arrow-w)" />
      <line x1="413" y1="216" x2="387" y2="216" marker-end="url(#dl-arrow-w)" />
      <line x1="219" y1="216" x2="193" y2="216" marker-end="url(#dl-arrow-w)" />
    </g>

    {
      wide.map((b) => (
        <g class={cls(b)}>
          <rect x={b.x} y={b.y} width={W.w} height={W.h} rx="6" />
          <text class="t" x={b.x + 14} y={b.y + 27}>{b.t}</text>
          <text class="s" x={b.x + 14} y={b.y + 47}>{b.s}</text>
        </g>
      ))
    }

    <g class="watch">
      <rect x="26" y="284" width="748" height="44" rx="6" />
      <text x="400" y="311" text-anchor="middle">
        <tspan class="t">Amazon CloudWatch</tspan><tspan class="s" dx="8">job metrics, failed loads and alerts</tspan>
      </text>
    </g>
  </svg>

  <svg class="dl-svg dl-svg--tall" viewBox={`0 0 340 ${tallEnd + 92}`} role="img" aria-label={label}>
    <defs>
      <marker id="dl-arrow-t" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="8" markerHeight="8" orient="auto">
        <path d="M0 0 L8 4 L0 8 z" />
      </marker>
    </defs>

    <rect class="frame" x="4" y="4" width="332" height={tallEnd + 80} rx="12" />
    <text class="frame-label" x="20" y="30">Your AWS account</text>

    <g class="wires">
      {
        tall.slice(0, -1).map((b) => (
          <line x1="170" y1={b.y + T.h + 1} x2="170" y2={b.y + T.step - 1} marker-end="url(#dl-arrow-t)" />
        ))
      }
    </g>

    {
      tall.map((b) => (
        <g class={cls(b)}>
          <rect x={b.x} y={b.y} width={T.w} height={T.h} rx="6" />
          <text class="t" x={b.x + 14} y={b.y + 21}>{b.t}</text>
          <text class="s" x={b.x + 14} y={b.y + 39}>{b.s}</text>
        </g>
      ))
    }

    <g class="watch">
      <rect x="20" y={tallEnd + 20} width="300" height="52" rx="6" />
      <text class="t" x="34" y={tallEnd + 41}>Amazon CloudWatch</text>
      <text class="s" x="34" y={tallEnd + 60}>Job metrics, failed loads and alerts</text>
    </g>
  </svg>

  <figcaption class="ui">
    Data lands in S3 as it arrives, Glue turns it into a curated zone, and Athena and QuickSight only
    ever read the curated data. CloudWatch watches every run.
  </figcaption>
</figure>

<style>
  .diagram {
    margin: 0 0 3rem;
    max-width: 52rem;
  }

  .dl-svg {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--font-display);
  }

  .dl-svg--wide {
    display: none;
  }

  @media (min-width: 40rem) {
    .dl-svg--wide {
      display: block;
    }
    .dl-svg--tall {
      display: none;
    }
  }

  .dl-svg--tall {
    max-width: 22rem;
  }

  .frame {
    fill: none;
    stroke: var(--rule);
    stroke-width: 1.5;
    stroke-dasharray: 6 5;
  }

  .frame-label {
    fill: var(--muted);
    font-size: 11.5px;
    font-weight: 500;
  }

  .wires line {
    stroke: var(--muted);
    stroke-width: 1.25;
  }

  marker path {
    fill: var(--muted);
  }

  .blk rect,
  .watch rect {
    fill: var(--paper-raised);
    stroke: var(--rule);
    stroke-width: 1.5;
  }

  .watch rect {
    stroke-dasharray: 4 4;
  }

  .t {
    fill: var(--ink);
    font-size: 13.5px;
    font-weight: 600;
  }

  .s {
    fill: var(--muted);
    font-size: 11.5px;
  }

  .dl-svg--tall .t {
    font-size: 15px;
  }

  .dl-svg--tall .s {
    font-size: 12.5px;
  }

  .blk.lake rect {
    fill: var(--accent-soft);
    stroke: var(--accent);
  }

  .blk.end rect {
    fill: var(--accent);
    stroke: var(--accent);
  }

  .blk.end .t,
  .blk.end .s {
    fill: var(--accent-ink);
  }

  figcaption {
    margin-top: 1rem;
    color: var(--muted);
    font-size: 0.95rem;
    max-width: 40rem;
  }
</style>

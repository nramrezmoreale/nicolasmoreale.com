---
// The hero: an Amazon Connect contact flow, drawn the way the flow
// designer shows it. On load a call travels the "in hours" path once and
// each block lights up as the call reaches it. Two layouts: wide for
// desktop, tall for phones. Times (--at) are when the call enters a block.

const label =
  'Contact flow diagram. A call enters, the flow checks hours of operation, and in hours it sets the working queue, transfers to the queue and an agent answers. Out of hours it plays a bilingual closed message and offers voicemail.';
---

<figure class="flow">
  <!-- Wide layout -->
  <svg class="flow-svg flow-svg--wide" viewBox="0 0 600 372" role="img" aria-label={label}>
    <defs>
      <marker id="arrow-w" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="8" markerHeight="8" orient="auto">
        <path d="M0 0 L8 4 L0 8 z" />
      </marker>
    </defs>

    <g class="wires">
      <line x1="150" y1="56" x2="150" y2="91" marker-end="url(#arrow-w)" />
      <line x1="270" y1="124" x2="329" y2="124" marker-end="url(#arrow-w)" />
      <line x1="450" y1="156" x2="450" y2="211" marker-end="url(#arrow-w)" />
      <line x1="450" y1="276" x2="450" y2="311" marker-end="url(#arrow-w)" />
      <line x1="150" y1="156" x2="150" y2="211" marker-end="url(#arrow-w)" />
      <line x1="150" y1="276" x2="150" y2="311" marker-end="url(#arrow-w)" />
    </g>

    <path class="route" pathLength="1" d="M150 36 L150 124 L450 124 L450 332" />
    <circle class="pulse" r="5.5">
      <animateMotion dur="2.4s" begin="0.5s" fill="freeze" path="M150 36 L150 124 L450 124 L450 332" />
    </circle>

    <g class="branch-labels">
      <text x="300" y="115" text-anchor="middle">In hours</text>
      <text x="160" y="189">Out of hours</text>
    </g>

    <g class="blk pill lit" style="--at: 0.3s">
      <rect x="95" y="16" width="110" height="40" rx="20" />
      <text class="t" x="150" y="41" text-anchor="middle">Entry</text>
    </g>
    <g class="blk lit" style="--at: 0.73s">
      <rect x="30" y="92" width="240" height="64" rx="6" />
      <text class="t" x="46" y="118">Check hours of operation</text>
      <text class="s" x="46" y="139">Support, US Eastern</text>
    </g>
    <g class="blk lit" style="--at: 1.58s">
      <rect x="330" y="92" width="240" height="64" rx="6" />
      <text class="t" x="346" y="118">Set working queue</text>
      <text class="s" x="346" y="139">Support</text>
    </g>
    <g class="blk lit" style="--at: 2.42s">
      <rect x="330" y="212" width="240" height="64" rx="6" />
      <text class="t" x="346" y="238">Transfer to queue</text>
      <text class="s" x="346" y="259">Callback offered after 2 minutes</text>
    </g>
    <g class="blk pill end lit" style="--at: 2.82s">
      <rect x="380" y="312" width="140" height="40" rx="20" />
      <text class="t" x="450" y="337" text-anchor="middle">Agent answers</text>
    </g>
    <g class="blk">
      <rect x="30" y="212" width="240" height="64" rx="6" />
      <text class="t" x="46" y="238">Play prompt</text>
      <text class="s" x="46" y="259">Bilingual closed message</text>
    </g>
    <g class="blk pill">
      <rect x="95" y="312" width="110" height="40" rx="20" />
      <text class="t" x="150" y="337" text-anchor="middle">Voicemail</text>
    </g>
  </svg>

  <!-- Tall layout -->
  <svg class="flow-svg flow-svg--tall" viewBox="0 0 320 460" role="img" aria-label={label}>
    <defs>
      <marker id="arrow-t" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="8" markerHeight="8" orient="auto">
        <path d="M0 0 L8 4 L0 8 z" />
      </marker>
    </defs>

    <g class="wires">
      <line x1="160" y1="52" x2="160" y2="87" marker-end="url(#arrow-t)" />
      <line x1="160" y1="152" x2="160" y2="199" marker-end="url(#arrow-t)" />
      <line x1="160" y1="264" x2="160" y2="311" marker-end="url(#arrow-t)" />
      <line x1="160" y1="376" x2="160" y2="411" marker-end="url(#arrow-t)" />
    </g>

    <path class="route" pathLength="1" d="M160 32 L160 432" />
    <circle class="pulse" r="5.5">
      <animateMotion dur="2.4s" begin="0.5s" fill="freeze" path="M160 32 L160 432" />
    </circle>

    <g class="branch-labels">
      <text x="170" y="181">In hours</text>
    </g>

    <g class="blk pill lit" style="--at: 0.3s">
      <rect x="105" y="12" width="110" height="40" rx="20" />
      <text class="t" x="160" y="37" text-anchor="middle">Entry</text>
    </g>
    <g class="blk lit" style="--at: 0.84s">
      <rect x="20" y="88" width="280" height="64" rx="6" />
      <text class="t" x="36" y="114">Check hours of operation</text>
      <text class="s" x="36" y="135">Support, US Eastern</text>
    </g>
    <g class="blk lit" style="--at: 1.51s">
      <rect x="20" y="200" width="280" height="64" rx="6" />
      <text class="t" x="36" y="226">Set working queue</text>
      <text class="s" x="36" y="247">Support</text>
    </g>
    <g class="blk lit" style="--at: 2.18s">
      <rect x="20" y="312" width="280" height="64" rx="6" />
      <text class="t" x="36" y="338">Transfer to queue</text>
      <text class="s" x="36" y="359">Callback offered after 2 minutes</text>
    </g>
    <g class="blk pill end lit" style="--at: 2.78s">
      <rect x="90" y="412" width="140" height="40" rx="20" />
      <text class="t" x="160" y="437" text-anchor="middle">Agent answers</text>
    </g>
  </svg>

  <figcaption class="ui">
    A contact flow: the path every call follows, block by block, from the moment it rings.
  </figcaption>
</figure>

<script>
  // Respect reduced motion: jump the SVG timeline to its end state.
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<SVGSVGElement>('.flow-svg').forEach((svg) => {
      svg.pauseAnimations();
      svg.setCurrentTime(10);
    });
  }
</script>

<style>
  .flow {
    margin: 0;
  }

  .flow-svg {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--font-display);
    overflow: visible;
  }

  .flow-svg--wide {
    display: none;
  }

  @media (min-width: 40rem) {
    .flow-svg--wide {
      display: block;
    }
    .flow-svg--tall {
      display: none;
    }
  }

  .flow-svg--tall {
    max-width: 22rem;
    margin-inline: auto;
  }

  .wires line,
  .wires path {
    stroke: var(--muted);
    stroke-width: 1.25;
  }

  marker path {
    fill: var(--muted);
  }

  .route {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.5;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 2.4s linear 0.5s forwards;
  }

  .pulse {
    fill: var(--accent);
  }

  .branch-labels text {
    fill: var(--muted);
    font-size: 11.5px;
    font-weight: 500;
  }

  .blk rect {
    fill: var(--paper-raised);
    stroke: var(--rule);
    stroke-width: 1.5;
  }

  .blk .t {
    fill: var(--ink);
    font-size: 14px;
    font-weight: 600;
  }

  .blk .s {
    fill: var(--muted);
    font-size: 12px;
  }

  .blk.lit rect {
    animation: light 300ms ease-out var(--at) forwards;
  }

  .blk.end rect {
    animation-name: answer;
  }

  .blk.end .t {
    animation: answer-text 300ms ease-out var(--at) forwards;
  }

  figcaption {
    margin-top: 1rem;
    color: var(--muted);
    font-size: 0.95rem;
    max-width: 30rem;
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes light {
    to {
      stroke: var(--accent);
      fill: var(--accent-soft);
    }
  }

  @keyframes answer {
    to {
      stroke: var(--accent);
      fill: var(--accent);
    }
  }

  @keyframes answer-text {
    to {
      fill: var(--accent-ink);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .route,
    .blk.lit rect,
    .blk.end .t {
      animation-duration: 1ms;
      animation-delay: 0s;
    }
    .pulse {
      display: none;
    }
  }
</style>
